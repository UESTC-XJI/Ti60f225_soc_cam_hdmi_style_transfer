# Efinity synthesis, place-and-route, debug and output directories.
# Root-anchored: do not hide similarly named source directories in IP/BSP.
/work_syn/
/work_style/
/work_style_next/
/work_style_final/
/work_style_ddr_opt/
/work_style_deadline/
/work_style_deadline_reserve/
/work_pnr/
# The style/ink builds added dated PnR work roots (work_pnr_v14, work_pnr_v15,
# work_pnr_nosplit, ...).  Cover the family, not just the bare name.
/work_pnr_*/
/work_dbg/
# /outflow/
/outflow_*/
# /netlist/

# External reference material and local tooling caches.  None of these are
# project deliverables: _data holds datasets (re-downloadable from the upstream
# ukiyoe2photo release), _wheels holds offline pip wheels, .cache holds torch
# weights, and the two -main/ trees are third-party reference checkouts.
/_data/
/_wheels/
/.cache/
/CIPGAN-main/
/pytorch-CycleGAN-and-pix2pix-master/

# Local scratch: root-level _*.py helpers and the iverilog temp dir.  These are
# throwaway probes; durable analysis lives in tools/analysis/.
/_*.py
/.tmp/

# Regression reports, intermediate release copies and hardware-debug captures.
# Keep notes, release checksums and the exact build input XML.
# Re-include directories so the file exceptions also work in future releases.
/reports/**/*
!/reports/**/
!/reports/**/*.md
!/reports/**/manifest.json
!/reports/**/build_project.xml
# Baseline source snapshots and simulation work products stay wholly local.
/reports/baseline/
/reports/simulation/
# Superseded split; the selected data_v2 manifest is versioned explicitly.
/reports/style_demo/data/
!/reports/style_demo/data_v2/*.json

# Local project lock held by the FPGA tool while the project is open.
/.lock

# Simulator work libraries and generated waveforms.
*.gtkw
*.vcd
*.fst
*.wlf
*.vpd
*.fsdb
*.vvp
vsim.wlf
transcript
modelsim.ini
/work/
/xsim.dir/
/.Xil/

# Embedded software build output (keep BSP, linker scripts and boot images).
**/Debug/
**/Release/
**/build/
*.o
*.obj
*.d
*.elf
*.axf
*.map
*.su

# Versioned release artifacts (after *.elf so published firmware stays visible).
!/reports/style_demo/release/
!/reports/**/*.bit
!/reports/**/*.elf

# Verified hardware releases under reports/<project>/releases/<tag>/.
# reports/README.md keeps bit, ELF, Markdown, manifest.json and build_project.xml
# for a version directory.  The style/ink projects additionally archive
#   * .hex   the SPI image that ftdi_program.py actually consumes, and
#   * _fw.bin the firmware loaded into DDR over OpenOCD.
# Both are needed because this project has no RISC-V toolchain and therefore no
# .elf; the raw .bin is the only carrier of the firmware (see the raw_resize and
# startup_colorbar directories, which version a .bin for the same reason).
!/reports/**/releases/**
!/reports/**/releases/**/*.bin
!/reports/**/releases/**/*.hex

# Per-run training artifacts are regenerable intermediate products: keep the
# Markdown and the dataset manifests, drop the checkpoints, previews and logs.
# (reports/README.md: "忽略日志及其他中间产出".)
/reports/**/*.pt
/reports/**/validation_*.png
/reports/**/*_console.log
/reports/**/*.log

# tools/analysis/ holds two kinds of file.  The trackable ones are the scripts
# that the Markdown reports actually cite, so a reader can reproduce the numbers;
# the rest are throwaway one-off probes written while investigating (all named
# with a leading underscore).  Ignore the directory, then re-include the cited
# set explicitly.  Re-including is done with a whitelist rather than a
# "!_*" pattern because the cited scripts share that prefix.
/tools/analysis/*
!/tools/analysis/_train_v2.py
!/tools/analysis/_train_local.py
!/tools/analysis/_run_ink.py
!/tools/analysis/_int_vs_fp.py
!/tools/analysis/_darkhf_calib.py
!/tools/analysis/_darkhf_check.py
!/tools/analysis/_build_neutral.py
!/tools/analysis/_test_128refs.py
!/tools/analysis/official_ref.py

# IDE workspace state; keep project configuration and launch definitions.
# (.idea is the JetBrains equivalent of the .vs and .metadata dirs below and has
# never been tracked in this repository.)
.metadata/
.vs/
.idea/
*.code-workspace
!/MonetStyleDemo.code-workspace

# Python caches for helper scripts.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Editor backups and operating-system clutter.
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
.DS_Store
Thumbs.db
Desktop.ini

# Deliberately keep:
# - rtl/ and ip/ (including generated/encrypted RTL required for compilation)
# - *.xml, *.peri.xml, *.sdc and package_settings.xml
# - debug_top.v, debug.json and debug_profile.wizard.json
#   (the current project references the debug source/profile)
# - *.mem, *.memh, *.hex, *.bin and *.mif outside output directories
#   (ROM/firmware initialization assets required by RTL/IP)
# - *.gtkw (reusable waveform viewing configuration)
# - ooc/ (do not exclude future out-of-context input configurations wholesale)
